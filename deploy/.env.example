# Copie para .env (ou rode ./gerar-env.sh, que já cria as chaves).
# Nunca versione o .env.

# Imagem fixa. Servidor ARM (Oracle Ampere): devlikeapro/waha:gows-arm-2026.9.2
WAHA_IMAGE=devlikeapro/waha:gows-2026.9.2

# Chave da API. A MESMA vai em WAHA_API_KEY no .env do backend.
# Gere com: openssl rand -hex 32
WAHA_API_KEY=

# Onde a porta do WAHA escuta (sem o Caddy).
#   127.0.0.1 = só a própria máquina (backend no mesmo servidor, fora do Docker)
#   IP privado da VPN/rede interna = backend em outro servidor na mesma rede
# Não use 0.0.0.0 sem firewall liberando só o IP do backend.
WAHA_BIND=127.0.0.1
WAHA_PORT=3000

# Limite de memória do contêiner (ver README para o tamanho por número de clientes).
WAHA_MEMORY_LIMIT=3g

# Espera antes de religar as sessões depois de reiniciar (segundos).
WAHA_AUTO_START_DELAY_SECONDS=5

# Logs: info em produção, debug só para investigar.
WAHA_LOG_LEVEL=info
WAHA_HTTP_LOG_LEVEL=warn

# --- HTTPS (profile "https", backend em outro servidor) ---
# Domínio apontando (registro A) para este servidor, ex.: waha.trovana.cloudflow.com.br
WAHA_DOMAIN=
# IPs que podem chamar o WAHA, separados por espaço (o IP de saída do backend).
WAHA_ALLOWED_IPS=
# Endereço público, ex.: https://waha.trovana.cloudflow.com.br
WAHA_BASE_URL=

# --- Depuração (deixe desligado em produção) ---
WAHA_DASHBOARD_ENABLED=False
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_ENABLED=False
WHATSAPP_SWAGGER_USERNAME=
WHATSAPP_SWAGGER_PASSWORD=
